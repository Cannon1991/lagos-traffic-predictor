   "source": [
    "# Step 1: Export a sample CSV data layout\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "def export_sample_layout():\n",
    "    routes = ['Third_Mainland_Bridge', 'Lekki_Epe_Expressway', 'Ikorodu_Road', 'Lagos_Ibadan_Expressway']\n",
    "    days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday']\n",
    "    \n",
    "    np.random.seed(42)\n",
    "    data = {\n",
    "        'Route': np.random.choice(routes, 100),\n",
    "        'Day_of_Week': np.random.choice(days, 100),\n",
    "        'Hour_of_Day': np.random.randint(0, 24, 100),\n",
    "        'Rainfall_Impact': np.random.choice([0, 1], 100, p=[0.8, 0.2]),\n",
    "        'Congestion_Level': np.random.choice(['Low', 'Medium', 'High'], 100)\n",
    "    }\n",
    "    df = pd.DataFrame(data)\n",
    "    df.to_csv('lagos_traffic_manual_test.csv', index=False)\n",
    "    print("Generated 'lagos_traffic_manual_test.csv' successfully!")\n",
    "\n",
    "export_sample_layout()"
   ]
  }
